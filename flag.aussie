G'DAY MATE!

// UTS Cyber Security challenge - from down unda.
I RECKON left = "";
I RECKON right = "";
I RECKON kept = 0;

// Remove every third number, double every second kept number, and reverse.
I RECKON n IS A WALKABOUT FROM [26 TO 1] <
    YA RECKON n % 3 != 0 ? <
        kept = kept + 1;
        I RECKON value = n;
        YA RECKON kept % 2 == 0 ? value = n * 2;
        YA RECKON kept <= 9 ? left = left + value + ",";
        WHATABOUT ? right = right + value + ",";
    >
>

GIMME "Flag: " + left + "straya," + right;
CHEERS C***!
