G'DAY MATE!

// UTS Cyber Security challenge - from down unda.
// Jumble the alphabet, then append generated numbers.
I RECKON alphabet = "qazwsxedcrfvtgbyhnujmikolp";
I RECKON numbers = "";
I RECKON n IS A WALKABOUT FROM [1 TO 26] <
    YA RECKON n % 2 == 0 ? numbers = numbers + n;
>
GIMME "Flag: " + alphabet + numbers;

CHEERS C***!
